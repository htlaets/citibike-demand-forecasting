.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.env
.DS_Store
.idea/
.vscode/

# Large/raw data is reproducibly downloaded by the ingestion layer.
data/raw/**
!data/raw/.gitkeep
data/quarantine/**
!data/quarantine/.gitkeep
data/quality/**
!data/quality/.gitkeep

# Generated dbt/Airflow state.
dbt/target/
dbt/logs/
airflow/logs/

# Trained models and experiment outputs are generated locally and persisted
# to GOLD tables where appropriate; do not commit binary model artifacts.
artifacts/models/**
!artifacts/models/.gitkeep
artifacts/metrics/**
!artifacts/metrics/.gitkeep
