# PostgreSQL
POSTGRES_DB=citibike
POSTGRES_USER=citibike
POSTGRES_PASSWORD=citibike
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy / application connection
DATABASE_URL=postgresql+psycopg://citibike:citibike@localhost:5432/citibike

# Project
PIPELINE_CONFIG=config/config.yaml
APP_TIMEZONE=America/New_York

# Optional: raises API limits for NYC Open Data (Socrata)
NYC_OPEN_DATA_APP_TOKEN=
