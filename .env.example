# PostgreSQL проекта
POSTGRES_DB=citibike
POSTGRES_USER=citibike
POSTGRES_PASSWORD=citibike
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Подключение Python-приложения к PostgreSQL
DATABASE_URL=postgresql+psycopg://citibike:citibike@127.0.0.1:5432/citibike

# Проект
PIPELINE_CONFIG=config/config.yaml
APP_TIMEZONE=America/New_York

# NYC Open Data: необязательный токен для увеличения лимитов Socrata API
NYC_OPEN_DATA_APP_TOKEN=

# Airflow
AIRFLOW_PORT=8080

# Superset
SUPERSET_PORT=8088
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_SECRET_KEY=change-me-to-a-long-random-local-secret
